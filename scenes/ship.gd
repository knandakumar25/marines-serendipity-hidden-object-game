# Used ChatGPT on 2/11/2025 to get the code for collecting objects when clicked on them.
# Prompt: I add 4 coconuts to the inventory and display them in a scene. On the top left, 
# I want the coconut inventory to be displayed as 4. When the player clicks on a coconut 
# it should disappear from the scene and be shown as collected.
# Used ChatGPT on 2/14/2025 to get the code for setting timer and reseting this scene after either
# success or failure of mission

# The for loop and onwards in func_ready and in func update_area2d_sizes are not generated by chatgpt.
# drsalin2 made the code on 2/24/2025 to update position and size depending on game window size
extends Node

var collected_items = {
	"knife": 0,
	"bandage": 0,
	"diary": 0,
	"canteen": 0
}
var total_items = {
	"knife": 1,
	"bandage": 1,
	"diary": 1,
	"canteen": 1
}

@onready var collected_label = get_node("UI/CollectedLabel")
@onready var timer = $Timer
@onready var message_label = get_node("UI/MessageLabel")
@onready var timer_label = get_node("UI/TimerLabel")
@onready var texture_rect = $UI/TextureRect
@onready var area2d_list = [$UI/TextureRect/Area2D, $UI/TextureRect/Area2D2, $UI/TextureRect/Area2D3, $UI/TextureRect/Area2D4]
@onready var previous_size := Vector2(1152, 648)
@onready var previous_scale = Vector2(0,0)

func _ready():
	update_collected_display()
	timer.wait_time = 35
	timer.start()
	timer.timeout.connect(_on_timer_timeout)
	
	for child in get_children():
		if child is Area2D:
			area2d_list.append(child)
	update_area2d_sizes()
	get_tree().get_root().connect("size_changed", Callable(self, "update_area2d_sizes"))

func update_area2d_sizes():
	await get_tree().create_timer(0.05).timeout  # Wait for 500 milliseconds (0.5 seconds)
	var current_size = texture_rect.size
	print("TextureRect current size:", current_size)  # Debugging output
	print("TextureRect previous size:", previous_size)  # Debugging output
	
	area2d_list = area2d_list.filter(func(area): return is_instance_valid(area)) # removes any objects that were clicked
	#var new_previous_scales = {}
	#for area in previous_scales:
	#	if is_instance_valid(area):
	#		new_previous_scales[area] = previous_scales[area]
	#previous_scales = new_previous_scales

	for area in area2d_list:
		if area:
			var scale_factor = current_size / previous_size  # scale factor based on previous and current size
			if(previous_scale == Vector2(0,0)):
				previous_scale = scale_factor
			print("Scale factor: ", scale_factor)
			print("Old Position:", area.position)  # Debug
			#if scale_factor > Vector2(1,1):
			#	area.scale *= scale_factor  # Apply scaling
			#else:
			#	area.scale = previous_scales[area] # Apply scaling
			if previous_size != current_size:
				if scale_factor > Vector2(1,1):
					area.scale *= 1.6
					print("New Scale:", area.scale)  # Debug
				else: if scale_factor < Vector2(1,1):
					area.scale /= 1.6
					print("New Scale:", area.scale)  # Debug
			area.position *= scale_factor
			print("New Position:", area.position)  # Debug
	previous_size = current_size
	print("...")

func _process(delta: float) -> void:
	update_timer_display()

func collect_item(item_name):
	item_name = item_name.to_lower()  # Ensure consistency

	if item_name in collected_items:
		collected_items[item_name] += 1
		update_collected_display()
		check_completion()
	else:
		print("⚠ ERROR: Key '" + item_name + "' not found in collected_items!")

func update_collected_display():
	if not collected_label:
		return

	var display_text = "Collected: "  # Start the line with "Collected:"

	# Loop through each item and add its count to the display text
	for item in collected_items.keys():
		display_text += item.capitalize() + ": " + str(collected_items[item]) + "/" + str(total_items[item]) + "  "

	# Set the collected label text to show all items on the same line
	collected_label.text = display_text

func update_timer_display():
	if timer_label:
		timer_label.text = "Time left: " + str(int(timer.time_left)) + "s"

func check_completion():
	for item in collected_items.keys():
		if collected_items[item] < total_items[item]:
			return
	timer.stop()
	message_label.text = "Success!"
	await get_tree().create_timer(2.0).timeout
	get_tree().change_scene_to_file("res://scenes/black2.tscn")

func _on_timer_timeout():
	message_label.text = "Time's up! Restarting..."
	await get_tree().create_timer(2.0).timeout
	get_tree().reload_current_scene()
